{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson"
  },
  "options": {"draftAndPublish": true},
  "attributes": {
    "title": {"type": "string", "required": true},
    "slug": {"type": "uid", "targetField": "title", "required": true},
    "language": {"type": "relation", "relation": "manyToOne", "target": "api::language.language", "required": true},
    "summary": {"type": "text"},
    "content": {"type": "richtext"},
    "level": {"type": "enumeration", "enum": ["beginner","intermediate","advanced"], "default": "beginner"},
    "duration": {"type": "integer"},
    "tags": {"type": "json"},
    "coverImage": {"type": "media", "allowedTypes": ["images"], "multiple": false},
    "publishedAt": {"type": "datetime"}
  }
}
